<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTrackerPrototype.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ExpenseTrackerPrototype"
    Title="ExpenseTrackerPrototype">

    <TabBar>
        <Tab Icon="settings_icon.png" Title="Settings">
            
        </Tab>
        <Tab Icon="home_icon.png" Title="Home">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Icon="add_icon.png" Title="Add">
            <ShellContent ContentTemplate="{DataTemplate local:NewPurchase}" Route="NewPurchase"/>
        </Tab>
    </TabBar>

</Shell>
